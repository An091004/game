{
  "name": "nhan-van-tu-tien-ky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/check-web-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start:web": "node scripts/serve-web.mjs dist",
    "check:web": "node scripts/check-web-dist.mjs",
    "package:web": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-web.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0"
  }
}
